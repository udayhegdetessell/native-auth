# Microsoft Entra External ID Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git!

# Entra External ID Tenant Configuration
ENTRA_TENANT_SUBDOMAIN=your-tenant-subdomain
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production-must-be-at-least-256-bits-long-for-hs256
JWT_TOKEN_LIFETIME_DAYS=30

# How to use:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Load environment variables: source .env (Linux/Mac) or set commands (Windows)
# 4. Run the application: ./gradlew bootRun

